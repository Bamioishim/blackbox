# Copy to .env.local for local development. Never commit real keys.

# Required for live agent negotiations (SERV Reasoning).
SERV_API_KEY=

# Optional model override. The code default is gpt-5.4-mini.
# SERV_MODEL=gpt-5.4-mini

# Required for marketplace accounts, listings and negotiations.
DATABASE_URL=
SESSION_SECRET=

# Optional public URL used in completion emails.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: email both sides when a marketplace negotiation reaches a deal.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Optional: bound Kite agent signing keys. If unset, the agent uses a per-deal key
# and the receipt is labelled unbound. Never commit real values.
# BLACKBOX_BUYER_AGENT_KEY=
# BLACKBOX_SELLER_AGENT_KEY=

# Optional. SETTLE_MODE=kite still falls back to the labelled in-app simulation
# in this build.
# SETTLE_MODE=simulated
