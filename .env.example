# Copy to .env.local for local development. Never commit real keys.

# 1Claw vault (recommended). When these are set, the SERV key, both Kite agent keys and the anchor
# wallet key are fetched just in time from 1Claw (paths blackbox/*), and the env vars below are ignored.
# ONECLAW_VAULT_ID=
# ONECLAW_AGENT_ID=
# ONECLAW_AGENT_API_KEY=       # ocv_... agent key with read on blackbox/*. Store as a Secret.
# ONECLAW_MONTHLY_CAP=30       # stop asking 1Claw after this many calls a month (free plan = 100)
# ONECLAW_SECRETS=serv         # which of serv,buyer,seller,anchor come from 1Claw (default: all)

# Without 1Claw: required for live agent negotiations (SERV Reasoning).
SERV_API_KEY=

# Optional model override. The code default is gpt-5.4-mini.
# SERV_MODEL=gpt-5.4-mini

# Required for marketplace accounts, listings and negotiations.
DATABASE_URL=

# Required: generate with: openssl rand -base64 48
# Must be at least 32 characters. Never reuse DATABASE_URL as a signing secret.
SESSION_SECRET=

# Optional public URL used in completion emails.
# NEXT_PUBLIC_APP_URL=https://blackbox-serv.vercel.app

# Optional: email both sides when a marketplace negotiation reaches a deal.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Optional: bound Kite agent signing keys. If unset, the agent uses a per-deal key
# and the receipt is labelled unbound. Never commit real values.
# BLACKBOX_BUYER_AGENT_KEY=
# BLACKBOX_SELLER_AGENT_KEY=

# Optional. SETTLE_MODE=kite still falls back to the labelled in-app simulation
# in this build.
# SETTLE_MODE=simulated

# Optional: real marketplace settlement (Kite Passport, USDC on Solana mainnet).
# SETTLEMENT_WORKER_SECRET=      # 32+ chars, shared with scripts/settle-worker.mjs. Store as a Secret.
# REAL_SETTLE_BUYER_EMAILS=      # comma-separated buyer emails allowed to request a real payment
# REAL_SETTLE_MAX_USDC=1
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: after a deal settles, write its final hash to Solana mainnet as an SPL Memo.
# JSON array of the 64-byte secret (or base58). Store as a Secret. Never commit.
# ANCHOR_SOLANA_SECRET_KEY=

# Optional: deploy/anchor the unused BlackboxAnchor contract on Kite testnet (chain 2368).
# This is a separate EVM deployer key file, not a Passport agent key; never commit it.
# ANCHOR_KEY_FILE=/absolute/path/to/protected/testnet-deployer.key
